{
  "name": "app-store-connect-mcp",
  "version": "0.2.1",
  "mcpName": "io.github.chrischall/app-store-connect-mcp",
  "description": "App Store Connect MCP server for Claude — apps, TestFlight, customer reviews, sales reports, and team users",
  "author": "Claude Code (AI) <https://www.anthropic.com/claude>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischall/app-store-connect-mcp.git"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "app-store-connect",
    "appstoreconnect",
    "apple",
    "ios",
    "testflight",
    "model-context-protocol",
    "claude",
    "ai",
    "app-store",
    "reviews",
    "sales-reports"
  ],
  "files": [
    "dist",
    ".claude-plugin",
    "skills",
    ".mcp.json",
    "server.json"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "type": "module",
  "bin": {
    "app-store-connect-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --external:dotenv --outfile=dist/bundle.js",
    "dev": "node --env-file=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@chrischall/mcp-utils": "^0.11.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
