{
  "name": "@chrischall/app-store-connect-mcp",
  "version": "1.0.0",
  "mcpName": "io.github.chrischall/app-store-connect-mcp",
  "description": "App Store Connect MCP server for Claude — apps, TestFlight, customer reviews, sales reports, and team users",
  "author": "Claude Code (AI) <https://www.anthropic.com/claude>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischall/app-store-connect-mcp.git"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "app-store-connect",
    "appstoreconnect",
    "apple",
    "ios",
    "testflight",
    "model-context-protocol",
    "claude",
    "ai",
    "app-store",
    "reviews",
    "sales-reports"
  ],
  "files": [
    "dist",
    ".claude-plugin",
    "skills",
    ".mcp.json",
    "server.json",
    "mint.yaml"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "type": "module",
  "bin": {
    "app-store-connect-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --alias:zod/v4=./node_modules/zod/v4/index.cjs --platform=node --format=esm --external:dotenv --outfile=dist/bundle.js",
    "dev": "node --env-file=.env dist/index.js",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@chrischall/mcp-utils": "^0.28.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^17.4.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
